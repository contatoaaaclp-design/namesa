# Copie este modelo para .env.local na raiz, ao lado de package.json.
# Se já preencheu .env, veja no README como renomear sem perder os valores.
# Não coloque valores reais neste modelo versionado.
# Deixe os campos desconhecidos vazios; não escreva null ou COLE_AQUI.
# Após editar .env.local, reinicie npm run dev.
# Na Vercel, cadastre cada variável no painel e faça novo deploy.

# 1. FIREBASE WEB — configuração pública, usada no navegador.
# Console Firebase > engrenagem > Configurações do projeto > Geral > Seus apps
# Registre um app Web (ícone </>) e abra a configuração do SDK, opção Config.
# Copie apenas o valor do campo indicado, sem vírgula final.

# Campo apiKey do firebaseConfig (não é a chave privada administrativa).
NEXT_PUBLIC_FIREBASE_API_KEY=
# Campo authDomain. Exemplo de formato: seu-projeto.firebaseapp.com
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
# Campo projectId. Use o ID do projeto, não o nome de exibição.
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
# Campo appId. Exemplo de formato: 1:123456789:web:identificador
NEXT_PUBLIC_FIREBASE_APP_ID=
# Campo messagingSenderId. Copie como texto, mesmo contendo apenas números.
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=

# 2. FIREBASE ADMIN — credenciais privadas, usadas SOMENTE no servidor.
# Mesmo projeto > Configurações > Contas de serviço > Firebase Admin SDK
# Gere uma chave privada e copie estes campos do JSON baixado.
# Guarde o JSON fora do repositório. Nunca use prefixo NEXT_PUBLIC_ aqui.

# Campo project_id. Deve ser igual a NEXT_PUBLIC_FIREBASE_PROJECT_ID.
FIREBASE_PROJECT_ID=
# Campo client_email. É o e-mail da conta de serviço, não o seu e-mail Google.
FIREBASE_CLIENT_EMAIL=
# Campo private_key completo (não confundir com private_key_id).
# Formato em UMA linha, com aspas duplas e uma barra antes de cada n:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nCHAVE_REAL\n-----END PRIVATE KEY-----\n"
# O exemplo acima não é uma chave válida; copie o conteúdo real do JSON.
FIREBASE_PRIVATE_KEY=

# 3. NOTIFICAÇÕES — pode preencher após configurar o Firebase básico.
# Configurações do projeto > Cloud Messaging > Web Push certificates
# Gere um par se necessário e copie a CHAVE PÚBLICA (VAPID).
# Não é apiKey, sender ID nem o certificado da conta de serviço.
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# 4. ENDEREÇO DO APP — valor local abaixo; na Vercel, use a URL HTTPS real.
# Exemplo em produção: https://seu-app.vercel.app (sem barra no final).
# O Pix real é bloqueado se APP_URL não começar com https://.
APP_URL=http://localhost:3000

# 5. EFI BANK — dados privados usados somente no servidor.
# API > Aplicacoes > API Pix. Credenciais e certificado precisam ser do mesmo ambiente.
# true: homologacao/testes. false: producao/recebimentos reais.
EFI_SANDBOX=true
EFI_CLIENT_ID=
EFI_CLIENT_SECRET=
# Conteudo COMPLETO do arquivo .p12 convertido em Base64 (nao e o caminho do arquivo).
# Copie este mesmo valor para a Vercel; nunca publique o .p12 no Git.
EFI_CERTIFICATE_BASE64=
# Deixe vazio se o .p12 nao tiver senha.
EFI_CERTIFICATE_PASSWORD=
# Chave Pix dedicada ao Inter na Mesa, cadastrada na conta Efi recebedora.
# Não reutilize chave cujo webhook ainda atende outro projeto.
EFI_PIX_KEY=
# Segredo criado por voce: 32 a 128 caracteres alfanumericos, _ ou -.
# Gere: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Cadastre o MESMO valor localmente e na Vercel ANTES de registrar o webhook.
EFI_WEBHOOK_SECRET=
# IP de origem informado na documentacao Efi; revalide se o provedor mudar os IPs.
# A API confere este IP no x-forwarded-for confiavel da Vercel.
EFI_WEBHOOK_ALLOWED_IPS=34.193.116.226

# 6. CRON — segredo criado por VOCÊ para proteger expiração e lembretes.
# Gere no terminal: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Cole o resultado aqui e no CRON_SECRET do ambiente Production da Vercel.
# Não é o segredo do webhook. Para lembretes, copie também para o secret CRON_SECRET do GitHub Actions.
# Na Vercel Hobby, o cron de expiração configurado roda uma vez ao dia.
CRON_SECRET=
# 7. CRÉDITO À VISTA — opcional; Pix continua funcionando sem esta seção.
# Ative API de Emissão de cobranças na aplicação Efí e obtenha aprovação de cartão/KYC.
# Libere true somente após testar a integração e preencher o identificador abaixo.
EFI_CREDIT_ENABLED=false
# Efí > API > Introdução > Identificador de conta. É público para tokenização no navegador.
# Não é Client ID, Client Secret nem chave Pix. Requer NOVO BUILD após preencher.
NEXT_PUBLIC_EFI_PAYEE_CODE=
# Se usar a mesma aplicação do Pix com Emissão de cobranças habilitada, deixe ambos vazios.
# Se a aplicação de cobranças for outra, preencha o par do MESMO ambiente de EFI_SANDBOX.
EFI_CARD_CLIENT_ID=
EFI_CARD_CLIENT_SECRET=
